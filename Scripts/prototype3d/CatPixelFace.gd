# Per-bucket layout, in art pixels relative to the face origin (the eye-centre
# row, the nose column):
#   gap / gap_min / gap_max / legacy_gap  pre-v4 edge-based placement, only
#            used for the tools' legacy before/after sheets (eyes are now
#            placed on centre anchors, see EYE SPACING RULES)
#   nose_dy  nose (stamp top) row below the eye-centre row
#   whisker_rows  rows below the nose row, one per whisker line (upper first)
#   whisker_in    pixels a near whisker starts INSIDE the cheek outline
#   whisker_out   pixels it reaches past the outline
#   far_len       length of a far-side whisker (sits on the cheek)
#   vein          accessory offset (x right, y down): right edge on the near
#                 eye's right edge, top above the eye
#   sweat         top-left offset from the near eye's top-right corner
#   tear          offset from the near eye's bottom-centre (part of the eye)
const LAYOUT: Dictionary = {
	"S": {"gap": 4, "gap_min": 3, "gap_max": 5, "legacy_gap": [2, 4], "nose_dy": 3, "whisker_rows": [1, 3], "whisker_in": 2, "whisker_out": 3, "far_len": 3, "vein": [0, -6], "sweat": [1, -1], "tear": [0, 0]},
	"M": {"gap": 5, "gap_min": 4, "gap_max": 6, "legacy_gap": [3, 5], "nose_dy": 4, "whisker_rows": [1, 3], "whisker_in": 3, "whisker_out": 3, "far_len": 4, "vein": [0, -7], "sweat": [1, -1], "tear": [0, 0]},
	"L": {"gap": 7, "gap_min": 5, "gap_max": 8, "legacy_gap": [4, 6], "nose_dy": 5, "whisker_rows": [2, 4], "whisker_in": 3, "whisker_out": 3, "far_len": 5, "vein": [0, -9], "sweat": [1, -2], "tear": [0, 0]},
}

# Mouth stamp per expression (open uses the genome's mouth).
const EXPRESSION_MOUTH: Dictionary = {
	"happy": "smile", "stressed": "flat", "sleepy": ":3", "angry": "frown",
	"worried": "flat", "sad": "wavy", "surprised": "o", "smug": ":3",
