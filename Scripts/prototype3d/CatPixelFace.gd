extends RefCounted

# Pixel-art face stamps for Cat2D's pixel renderer.
# No class_name on purpose: preload("res://Scripts/prototype3d/CatPixelFace.gd").
#
# HOW TO EDIT
#   Every stamp is an array of equal-length strings, one string per pixel row,
#   one character per art pixel. The EYES table is generated by
#   Tools/gen_eye_stamps.py from the open-eye silhouettes in
#   Tools/eye_silhouettes.txt (outline) and the per-shape design table SPEC in
#   that script (iris layers, pupil, glints, light lower line and every
#   expression); edit those and rerun it rather than hand-editing stamps here
#   (keep every row of a stamp the same length and every expression of one eye
#   shape the same size). Render with:
#     godot --path . --script res://Tools/render_cat_seeds.gd -- out.png pixel faces
#   CatPixelFace.validate() (run by that sheet and by validate_data) prints any
#   malformed stamp.
#
# EYE LEGEND (iris = 3-step ramp of the genome eye colour)
#   .  nothing (fur shows through)     #  eye line (dark)
#   L  upper lid / eye line (dark)     p  pupil
#   d  iris dark (top band; also the light lower eye line)
#   o  iris mid                        l  iris light (lower crescent)
#   w  glint (white)                   e  eye white
#   (b  bead: legacy, unused by the current shapes)
# Eye line: only the upper half of the outline is the dark line; the lower
# half is drawn in the dark-iris tone (light line), and every open pupil keeps
# >= 1px of iris / glint between it and the line on the left, right and below.
# Stamps are authored as the NEAR eye (inner corner = left, outer = right).
# Both eyes use the SAME stamp (never scaled, so they are always identical);
# shapes in MIRROR_FAR and expressions in MIRROR_EXPR (slanted lids) mirror it
# for the far eye so both lids slant symmetrically about the nose. Each eye is
# centred on its landmark anchor (Cat2D eye_near / eye_far); the 3/4 view
# lives in their asymmetry. See EYE SPACING RULES below for the hard minimums.
# Expressions: open, stressed (small pupil), sleepy (lid over the top ~55%),
# closed (lower arc; blink), happy (upper arc), angry (lids slanted down to
# the nose + anger vein), worried (inner lid raised, smaller pupil + sweat
# drop), sad (droopy outer lid, glossy, tear), surprised (tiny pupil, "o"
# mouth), smug (half-lidded, ":3").
#
# NOSE / MOUTH LEGEND (one stamp = nose + mouth, centred on the snoot axis,
# top row = nose row; see SNOOT_FORWARD_PX)
#   n  nose pink      N  nose shadow (dark pink; mouth colour on dark muzzles)
#   m  mouth line     r  mouth inside
#
# ACCESSORY LEGEND (expression marks, drawn as decals at LAYOUT anchors)
#   v  anger vein (red)   s  sweat drop (blue)   t  tear (pale blue)   w  white
#
# Size buckets by effective art density (art px across the 76.8-unit window,
# times the fit scale): S <= 60, M <= 84, L above.

const BUCKET_S_MAX: int = 60
const BUCKET_M_MAX: int = 84
# Legacy only (pre-v4 before/after sheets): the old far-eye inward shift.
const FAR_SHIFT: int = 1
# SNOOT AXIS (pixel mode): the nose + mouth stamp's centre column and the
# centre of the cream muzzle patch (tabby / tuxedo; also the tuxedo blaze and
# the siamese mask) sit on the midpoint of the two PLACED eyes' footprints
# (far eye left column .. near eye right column, after fallback stamps, gap
# push and face slide) plus SNOOT_FORWARD_PX art px toward the facing side:
# the snoot pokes slightly forward in the 3/4 view, away from the body (+1 px
# right when facing right, mirrored when facing left). A midpoint that falls
# between two columns rounds toward the facing side as well (so the nose sits
# +1 or +1.5 px from the exact eye midpoint). Cat2D._pixel_face_layout
# ("snoot_x"), _draw_pixel_face and _pixel_snoot_dx apply it; whiskers anchor
# on the same axis. Smooth mode keeps its own landmarks (nose 0.125 x head
# size forward of the eye midpoint).
const SNOOT_FORWARD_PX: int = 1

