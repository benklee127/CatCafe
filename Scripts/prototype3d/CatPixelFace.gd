# EYE SPACING RULES (global: every shape, expression incl. blink, density,
# pose, facing, genome and debug override). The one place to tune them; Cat2D
# enforces them (push_warning if a layout ever breaks the gap) and
# Tools/check_eye_contacts.gd verifies them on rendered pixels.
#   Placement   each eye is CENTRED on its landmark anchor, so a smaller
#               stamp always gets a larger gap; stamps too wide for the
#               anchors push the eyes apart.
#   MIN_EYE_GAP_PX     fur columns between the two eyes' footprints (stamp,
#                      lids, lashes, arcs, tear) per density bucket. Nothing
#                      narrows it: when an eye would not keep MIN_EYE_EDGE_PX
#                      from its cheek outline, Cat2D (a) keeps the gap, (b)
#                      falls back to the smaller stamp sets in STAMP_FALLBACK
#                      on the same centres, (c) slides the whole face (nose
#                      included) up to MAX_FACE_SLIDE_PX toward the far cheek.
#   MIN_EYE_EDGE_PX    fur columns between an eye and the head / ear outline
#                      (sides and top).
#   MIN_EYE_GAP_UNITS  smooth renderer: gap between the two eye shapes
#                      (outline + lid strokes) in rig units / head size.
#   MIN_HEAD           anchors and cheek room (columns from the nose axis) of
#                      the smallest supported head (head_size 0.8) at each
#                      bucket's lowest density (S 48, M 61, L 85), measured
#                      from Cat2D; validate() flags any shape whose fallback
#                      chain has no stamp that fits it.
const MIN_EYE_GAP_PX: Dictionary = {"S": 3, "M": 4, "L": 5}
const MIN_EYE_EDGE_PX: int = 1
const MIN_EYE_GAP_UNITS: float = 3.0
const MAX_FACE_SLIDE_PX: int = 2
const MIN_HEAD: Dictionary = {
	"S": {"near_c": 3.45, "far_c": -3.30, "near_edge": 4, "far_edge": -7},
	"M": {"near_c": 5.12, "far_c": -4.17, "near_edge": 7, "far_edge": -10},
	"L": {"near_c": 6.53, "far_c": -6.41, "near_edge": 10, "far_edge": -15},
}

# Same placement as Cat2D._pixel_face_layout for an ew-wide stamp on a head
# described like MIN_HEAD: returns the face slide that fits, or -99.
static func fit_slide(bucket: String, ew: int, head: Dictionary) -> int:
	var min_fur: int = min_eye_gap(bucket)
	var nl: int = roundi(float(head["near_c"]) - float(ew) * 0.5)
	var fl: int = roundi(float(head["far_c"]) - float(ew) * 0.5)
	var short: int = min_fur - (nl - fl - ew)
	if short > 0:
		nl += (short + 1) / 2
		fl -= short / 2
	for k in range(MAX_FACE_SLIDE_PX + 1):
		if nl - k + ew - 1 <= int(head["near_edge"]) - MIN_EYE_EDGE_PX and fl - k >= int(head["far_edge"]) + MIN_EYE_EDGE_PX:
			return -k
	return -99

static func min_eye_gap(bucket: String) -> int:
	return int(MIN_EYE_GAP_PX.get(bucket, MIN_EYE_GAP_PX["S"]))

# Stamp sets tried in order when a face is too small for its bucket's stamps
# ("XS" = compact fallback stamps, "XXS" = tiny last resort; never picked
# by density). Cat2D expands each set with its size alternates (stamp_chain).
const STAMP_FALLBACK: Dictionary = {"L": ["L", "M", "S", "XS", "XXS"], "M": ["M", "S", "XS", "XXS"], "S": ["S", "XS", "XXS"]}

static func stamp_fallbacks(bucket: String) -> Array:
	return STAMP_FALLBACK.get(bucket, ["S", "XS"])

# Size alternates of a set ("<set>-t" +1 tall only, "-w" +1 wide only, "-0"
# silhouette size) exist for the shapes drawn 1px larger (big, big_slit);
# they are tried right after their set, before the next smaller set.
const STAMP_ALT_SUFFIX: Array[String] = ["-t", "-w", "-0"]

# Stamp sets tried in order for this shape: each set of `sets` followed by
# its size alternates.
static func expand_chain(sets: Array, shape: String) -> Array:
	var out: Array = []
	for sb in sets:
		out.append(sb)
		for suf in STAMP_ALT_SUFFIX:
			var k: String = str(sb) + suf
			if EYES.has(k) and (EYES[k] as Dictionary).has(shape):
				out.append(k)
	return out

static func stamp_chain(bucket: String, shape: String) -> Array:
	return expand_chain(stamp_fallbacks(bucket), shape)

# Base set of a stamp set name ("M-t" -> "M").
static func base_set(sb: String) -> String:
	return sb.get_slice("-", 0)

static func bucket_for(density: float) -> String:
	if density <= float(BUCKET_S_MAX):
		return "S"
	if density <= float(BUCKET_M_MAX):
		return "M"
	return "L"

static func eye(bucket: String, shape: String, expression: String, far: bool = false) -> Array:
	var b: Dictionary = EYES.get(bucket, EYES["S"])
	if not b.has(shape):
		# size alternates only hold the shapes that have them
		b = EYES.get(base_set(bucket), EYES["S"])
	var s: Dictionary = b.get(shape, {}) if b.has(shape) else b["round"]
	var rows: Array = s.get(expression, s["open"])
	if far and (MIRROR_FAR.has(shape) or MIRROR_EXPR.has(expression)):
		var out: Array = []
		for r in rows:
			out.append(str(r).reverse())
		return out
	return rows

static func mouth(bucket: String, kind: String) -> Array:
	var b: Dictionary = MOUTHS.get(bucket, MOUTHS["S"])
	return b.get(kind, b["w"])

static func layout(bucket: String) -> Dictionary:
	return LAYOUT.get(bucket, LAYOUT["S"])

# Accessory stamp (vein / sweat / tear) or [] when none.
static func accessory(bucket: String, kind: String) -> Array:
	var b: Dictionary = ACCESSORIES.get(bucket, ACCESSORIES["S"])
	return b.get(kind, [])

# Returns a list of problems (empty = all stamps well formed).
static func validate() -> Array[String]:
	var out: Array[String] = []
	# Spacing: some stamp in every shape's fallback chain fits the smallest head.
	for b in MIN_HEAD.keys():
		for shape in EYE_SHAPES:
			var ok: bool = false
			for sb in stamp_chain(b, shape):
				if EYES.has(sb) and EYES[sb].has(shape):
					var rows: Array = EYES[sb][shape]["open"]
					if fit_slide(b, str(rows[0]).length(), MIN_HEAD[b]) > -99:
						ok = true
						break
			if not ok:
				out.append("%s/%s: no stamp in %s keeps MIN_EYE_GAP_PX + MIN_EYE_EDGE_PX on the smallest head" % [b, shape, str(stamp_chain(b, shape))])
	for b in EYES.keys():
		for shape in EYE_SHAPES:
			if not EYES[b].has(shape) and base_set(b) == b:
				out.append("%s/%s missing" % [b, shape])
		for shape in EYES[b].keys():
			var w: int = -1
			var h: int = -1
			for ex in EXPRESSIONS:
				var rows: Array = EYES[b][shape].get(ex, [])
				if rows.is_empty():
					out.append("%s/%s/%s missing" % [b, shape, ex])
					continue
				if h < 0:
					h = rows.size()
					w = str(rows[0]).length()
				if rows.size() != h:
					out.append("%s/%s/%s has %d rows, expected %d" % [b, shape, ex, rows.size(), h])
				for r in rows:
					if str(r).length() != w:
						out.append("%s/%s/%s row '%s' is not %d wide" % [b, shape, ex, r, w])
					for ch in str(r):
						if not STAMP_CHARS.contains(ch):
							out.append("%s/%s/%s row '%s' has unknown char '%s'" % [b, shape, ex, r, ch])
	for b in ACCESSORIES.keys():
		for k in ACCESSORIES[b].keys():
			var rows: Array = ACCESSORIES[b][k]
			for r in rows:
				if str(r).length() != str(rows[0]).length():
					out.append("accessory %s/%s row '%s' has a different width" % [b, k, r])
	for ex in EXPRESSION_MOUTH.keys():
		for b in MOUTHS.keys():
			if not MOUTHS[b].has(EXPRESSION_MOUTH[ex]):
				out.append("mouth %s/%s (for %s) missing" % [b, EXPRESSION_MOUTH[ex], ex])
	for b in MOUTHS.keys():
		for k in MOUTHS[b].keys():
			var rows: Array = MOUTHS[b][k]
			var w: int = str(rows[0]).length()
			if w % 2 == 0:
				out.append("mouth %s/%s has even width" % [b, k])
			for r in rows:
				if str(r).length() != w:
					out.append("mouth %s/%s row '%s' is not %d wide" % [b, k, r, w])
	return out
