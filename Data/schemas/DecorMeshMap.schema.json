{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecorMeshMap",
  "description": "One entry of Data/decor_mesh_map.json (owned by the level track). The file may be a plain array of entries or an object holding the entries under 'entries' (plus file-level keys such as grid_unit). Extra keys are allowed.",
  "type": "object",
  "required": ["decor_id", "mesh_scene", "footprint", "rotations", "slot_markers"],
  "properties": {
    "decor_id": {"type": "string"},
    "mesh_scene": {"type": "string"},
    "footprint": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/offset"}},
    "blocking_footprint": {"type": "array", "items": {"$ref": "#/$defs/offset"}},
    "pivot_offset": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "scale": {"type": ["number", "array"]},
    "grid_unit": {"type": "integer", "minimum": 1},
    "rotations": {"type": "array", "items": {"type": "integer", "enum": [0, 90, 180, 270]}},
    "slot_markers": {
      "type": "object",
      "properties": {
        "patron": {"type": "array", "items": {"$ref": "#/$defs/offset"}},
        "cat": {"type": "array", "items": {"$ref": "#/$defs/offset"}}
      }
    }
  },
  "$defs": {
    "offset": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}
  }
}
