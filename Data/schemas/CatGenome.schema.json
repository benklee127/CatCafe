{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CatGenome",
  "description": "JSON-safe genome consumed by Cat2D.apply_genome (contract 1.2). Every key is optional. Colors may also be [r,g,b(,a)] arrays at runtime; stored genomes use #hex strings.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "genome_version": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "breed": {"type": "string", "enum": ["domestic", "sphynx", "maine_coon"]},
    "rarity": {"type": "string", "enum": ["common", "uncommon", "rare"]},
    "coat": {"type": "string", "enum": ["tabby", "tuxedo", "calico", "black", "siamese", "ginger", "sphynx"]},
    "fur": {"type": "string", "enum": ["none", "short", "medium", "long"]},
    "eye": {"type": "string", "enum": ["amber", "green", "hazel", "gold", "blue"]},
    "tail": {"type": "string", "enum": ["classic", "long", "plume", "stubby"]},
    "fur_primary": {"$ref": "#/$defs/color"},
    "fur_secondary": {"$ref": "#/$defs/color"},
    "eye_color": {"description": "Optional override; null means use the eye preset.", "type": ["string", "array", "null"]},
    "body_scale": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0.5, "maximum": 2.0}},
    "head_size": {"type": "number", "minimum": 0.5, "maximum": 2.0},
    "leg_length": {"type": "number", "minimum": 0.5, "maximum": 2.0},
    "tail_length": {"type": "number", "minimum": 0.5, "maximum": 2.0},
    "tail_thickness": {"type": "number", "minimum": 0.5, "maximum": 2.0},
    "ear_size": {"type": "number", "minimum": 0.5, "maximum": 2.0},
    "body_length": {"description": "v2 torso length multiplier (multiplies legacy body_scale[0]).", "type": "number", "minimum": 0.5, "maximum": 2.0},
    "body_girth": {"description": "v2 torso thickness multiplier (multiplies legacy body_scale[1]).", "type": "number", "minimum": 0.5, "maximum": 2.0},
    "leg_thickness": {"type": "number", "minimum": 0.5, "maximum": 2.0},
    "cheek_width": {"type": "number", "minimum": 0.5, "maximum": 2.0},
    "neck_fluff": {"description": "Chest ruff size; 0 = none, 1 = default.", "type": "number", "minimum": 0, "maximum": 3.0},
    "haunch_size": {"type": "number", "minimum": 0.5, "maximum": 2.0},
    "fur_style": {"description": "Fur edge look. Missing/null = mapped from the legacy 'fur' key (none/short -> flat, medium -> medium, long -> fuzzy).", "type": ["string", "null"], "enum": ["flat", "medium", "fuzzy", null]},
    "fur_length": {"description": "Tuft amplitude in rig units (ignored for flat).", "type": ["number", "null"], "minimum": 0, "maximum": 3.0},
    "fur_density": {"description": "Tufts per rig unit of edge length.", "type": ["number", "null"], "minimum": 0.05, "maximum": 2.0},
    "fur_jitter": {"description": "0..1 tuft randomness.", "type": ["number", "null"], "minimum": 0, "maximum": 1.0},
    "tail_sway_deg": {"type": "number", "minimum": 0},
    "tail_sway_speed": {"type": "number", "minimum": 0},
    "idle_fidget_rate": {"type": "number", "minimum": 0},
    "walk_speed_mult": {"type": "number", "minimum": 0},
    "eye_shape": {"description": "Pixel-art eye stamp (Scripts/prototype3d/CatPixelFace.gd). Missing/null = breed/coat default or a seeded pick.", "type": ["string", "null"], "enum": ["round", "big", "almond", "slit", "big_slit", "gentle", "mischievous", "wide", null]}
  },
  "$defs": {
    "color": {"type": ["string", "array"]}
  }
}
