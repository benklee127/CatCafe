{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecorDefinition",
  "type": "object",
  "required": ["id", "display_name", "category", "cost", "buffs", "aura_radius", "stack_rule", "placement"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "display_name": {"type": "string"},
    "category": {"type": "string", "enum": ["customer", "cat", "flow", "meta"]},
    "cost": {"type": "integer", "minimum": 0},
    "buffs": {"type": "object", "additionalProperties": {"type": "number"}},
    "aura_radius": {"type": "number", "minimum": 0},
    "stack_rule": {"type": "string", "enum": ["additive", "diminishing", "unique"]},
    "placement": {
      "type": "object",
      "required": ["walkable"],
      "additionalProperties": false,
      "properties": {
        "walkable": {"type": "boolean"}
      }
    },
    "unlock_tier": {"type": "integer", "minimum": 1}
  }
}
